<mujoco model="pan_tilt_camera">
  <option timestep="0.002"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1"/>

    <!-- Something to look at -->
    <geom name="target" type="sphere" size="0.1" pos="2 0.5 0.5" rgba="1 0 0 1"/>
    <geom name="target2" type="box" size="0.1 0.1 0.1" pos="2 -0.7 0.3" rgba="0 0.8 0 1"/>

    <!-- Fixed base / tripod -->
    <body name="base" pos="0 0 0">
      <geom type="cylinder" size="0.05 0.25" pos="0 0 0.25" rgba="0.3 0.3 0.3 1"/>

      <!-- PAN: rotates about world Z -->
      <body name="pan_link" pos="0 0 0.5">
        <joint name="pan" type="hinge" axis="0 0 1" range="-170 170"
               damping="0.5" armature="0.01"/>
        <geom type="cylinder" size="0.04 0.02" rgba="0.2 0.4 0.8 1" mass="0.1"/>

        <!-- TILT: rotates about Y (axis -Y so positive = look up) -->
        <body name="tilt_link" pos="0 0 0.05">
          <joint name="tilt" type="hinge" axis="0 -1 0" range="-60 80"
                 damping="0.5" armature="0.01"/>
          <geom type="box" size="0.04 0.03 0.03" pos="0.04 0 0" rgba="0.1 0.1 0.1 1" mass="0.2"/>

          <!-- Camera looks along +X of the tilt body -->
          <camera name="ptz_cam" pos="0.08 0 0"
                  xyaxes="0 -1 0  0 0 1" fovy="60"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="pan_servo"  joint="pan"  kp="20" kv="1" ctrlrange="-2.9 2.9"/>
    <position name="tilt_servo" joint="tilt" kp="20" kv="1" ctrlrange="-1.0 1.4"/>
  </actuator>
</mujoco>