-# Single source of truth for: observation layout, network size, BC + PPO hyperparameters,
-# env/reward settings and eval grid. Used by gen_mpc_data.py, the Playground env, BC, train.py, eval.py.
-# CHANGING anything under `obs:` changes the observation size -> regenerate datasets + retrain.
-
-policy_hz: 50.0
-
-obs:
-  action_history_s: 0.5     # seconds of past actions fed to the net  (N = round(s * policy_hz) = 25 steps)
-  action_scale: 1.0         # q_target = q_default + action_scale * action   (must match the teacher labels)
-  # !! Set these to the values that were in your old rl/environments/env.py (the defaults are legged_gym-style guesses)
-  gyro_scale: 0.25
-  cmd_scale_lin: 2.0         # applies to both v_x and v_y
-  cmd_scale_ang: 0.25
-  qd_scale: 0.05
-
-# Observation layout (flattened, in this order):
-#   gyro(3) | gravity in body frame(3) | cmd [v_x m/s, v_y m/s, yaw_rate rad/s](3) | q - q_default(12) | qd(12) | past actions (N*12, oldest -> newest)
-#   v_y is always 0 in the MPC data (the MPC has no lateral command); it becomes active in the RL stage.
-
-# The MPC's own commands = the distinct `cmd` values stored in these (relabeled) datasets. They drive
-#   (a) env.cmd_bank_prob: part of the training commands are drawn from this set
-#   (b) bc_reg: only states whose command is near one of these are pulled toward the BC baseline
-# Paths are relative to the repo root.
-baseline_cmds:
-  dirs: [python/rl/data/mpc_relabeled, python/rl/data/mpc_train_relabeled]
-  decimals: 4
-
-actor:
-  hidden_dims: [512, 256, 128]   # number of layers = len(hidden_dims)
-  activation: elu                # elu | relu | tanh | selu | lrelu
-  init_std: 0.02                  # small so PPO fine-tuning doesn't wash out the BC policy
-
-critic:
-  hidden_dims: [512, 256, 128]
-  activation: elu
-
-bc:
-  lr: 1.0e-3
-  weight_decay: 1.0e-5
-  # Anti-copycat augmentation: the 25-step action history makes 'repeat the last action' an easy shortcut.
-  history_noise_std: 0.02        # gaussian noise (action units) added to the history inputs during training
-  history_dropout_p: 0.2         # per-sample probability that the whole history is zeroed during training
-  epochs: 60
-  batch_size: 4096
-  val_frac: 0.1                  # only used when --val_dir is not given
-
-ppo:
-  num_learning_epochs: 5
-  num_mini_batches: 4
-  learning_rate: 3.0e-5          # low: we start from a BC policy
-  schedule: adaptive
-  gamma: 0.99
-  lam: 0.95
-  entropy_coef: 0.0
-  desired_kl: 0.01
-  max_grad_norm: 1.0
-  value_loss_coef: 1.0
-  use_clipped_value_loss: true
-  clip_param: 0.2
-
-runner:
-  num_steps_per_env: 24
-  max_iterations: 1500
-  save_interval: 50
-  experiment_name: bc_ppo
-  run_name: ""
-  logger: tensorboard
-  seed: 1
-
-env:
-  episode_length: 1000           # policy steps (20 s at 50 Hz)
-  cmd_vx_range: [-0.08333, 0.08333]    # m/s, negative = backward  <- set to your MPC's range (lc.v_max_mm_s / 1000)
-  cmd_vy_range: [0.0, 0.0]       # m/s, lateral: 0 until the lateral curriculum stage (the MPC cannot do it)
-  cmd_yaw_range: [-0.5, 0.5]     # rad/s
-  cmd_bank_prob: 0.5             # probability that a sampled command is one of the MPC's own (baseline_cmds); else uniform
-  stand_prob: 0.1                # probability that a freshly sampled UNIFORM command is "stand still"
-  cmd_resample_s: [1.0, 3.0]     # new command every U(lo, hi) seconds; [0, 0] disables mid-episode changes
-  cmd_p_brake: 0.15              # at a command change: go to zero (braking)
-  cmd_p_flip: 0.15               # at a command change: reverse the current command (direction change)
-  min_height_frac: 0.6           # terminate if base z < frac * measured standing height
-  push:
-    prob: 0.8                    # fraction of episodes that get one push
-    accel_range: [0.5, 5.0]      # push acceleration in m/s^2 (force = accel * mass); eval tests up to 4.0
-    t_range_s: [1.0, 8.0]
-    dur_s: 0.1
-  dr:                            # domain randomisation, sampled per episode (eval.py turns it off)
-    enabled: true
-    friction_range: [0.6, 1.4]         # scale on geom sliding friction
-    motor_strength_range: [0.85, 1.15] # scale on servo kp
-    mass_scale_range: [0.9, 1.1]       # payload: scales base weight
-    latency_steps_max: 1               # action delay of 0..N policy steps (20 ms each)
-  track_sigma_lin: 0.02         # exp(-err^2 / sigma)
-  track_sigma_yaw: 0.01
-  air_time_target: 0.2           # s: swing shorter than this at touchdown is penalised, longer is rewarded
-  air_time_bonus_clip: 0.3
-  joint_limit_margin: 0.05       # rad
-  reward_scales:
-    track_lin: 1.0
-    track_yaw: 0.75
-    upright: -2.0
-    action_rate: -0.05
-    pose: -0.02                  # weak: agile motion must be allowed to leave the default pose
-    alive: 0.1
-    feet_air_time: 0.5
-    foot_slip: -0.1
-    torque: -0.05                # dimensionless (normalised by actuator force range)
-    joint_limit: -1.0
-    termination: -10.0
-
-# Keeps the PPO actor close to the frozen BC baseline, ONLY on states whose command the MPC actually executes
-# (see baseline_cmds and rl/bc_reg.py). Elsewhere PPO is free.
-bc_reg:
-  enabled: true
-  coef: 1.0                      # NOTE: Adam is scale-invariant, so this has almost no effect; lr and steps_per_iter set the strength
-  lr: 1.0e-4
-  steps_per_iter: 10             # supervised steps after every PPO update
-  batch_size: 4096
-  tol_v: 0.005                   # m/s   a command counts as "baseline" if within these tolerances of an MPC command
-  tol_yaw: 0.02                  # rad/s
-  anneal_iters: 600              # linearly fade the regulariser to 0 over this many iterations (0 = never fade)
-
-eval:
-  cmds: [[0.0, 0.0, 0.0], [0.08, 0.0, 0.0], [-0.08, 0.0, 0.0], [0.0, 0.0, 0.3], [0.08, 0.0, 0.3]]   # [vx, vy, yaw]; only used when eval.py has no --manifest
-  accels: [1.0, 2.0, 3.0, 4.0]
-  angles_deg: [0, 90, 180, 270]
-  push_t_s: 6.0
-  episode_s: 10.0
\ No newline at end of file
